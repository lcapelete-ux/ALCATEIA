rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidParticipant(data) {
      return data.keys().hasAll(['id', 'bibNumber', 'fullName', 'gender', 'city', 'shirtSize', 'modality', 'price', 'paymentStatus', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.bibNumber is number && data.bibNumber > 0
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 150
        && data.gender in ['Masculino', 'Feminino']
        && data.shirtSize in ['Baby Look P', 'Baby Look M', 'Baby Look G', 'P', 'M', 'G', 'GG', 'XG']
        && data.modality in ['Corrida Livre 5km', 'Corrida Livre 8km']
        && data.price is number
        && data.paymentStatus in ['Confirmado', 'Pendente', 'Cancelado']
        && data.createdAt is string;
    }

    match /participants/{participantId} {
      allow read: if true;
      allow create: if isValidId(participantId) && isValidParticipant(request.resource.data);
      allow update: if isValidId(participantId);
      allow delete: if isValidId(participantId);
    }

    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
